@page "/"
@using BookStore.Frontend.Dtos
@using BookStore.Frontend.Clients
@inject BookClient Clients
@inject AuthorClient AuthorClients

<PageTitle>My Book Store</PageTitle>

<h1>📚 My Book Store</h1>


<h4>Add a Book</h4>
<EditForm Model="newBook" OnValidSubmit="HandleAddBook">
    <DataAnnotationsValidator />
    <div>
        <label>Title</label>
        <InputText @bind-Value="newBook.Name" />
    </div>
    <div>
    <label>Author</label>
    <InputSelect @bind-Value="newBook.AuthorId" class="form-control" style="width: 230px">
        <option value="0">-- Select Author --</option>
        @foreach (var author in authors ?? [])
        {
            <option value="@author.Id">@author.Name</option>
        }
    </InputSelect>
    </div>
    <div>
        <label>Price</label
        <InputNumber @bind-Value="newBook.Price" />
    </div>
    <div>
        <label>Release Date</label>
        <InputDate @bind-Value="newBook.ReleaseDate" />
    </div>
    <button type="submit">Add Book</button>

</EditForm>

@if (errMessage is not null)
{
    <p style="color:red">@errMessage</p>
}

@if (editingBook is not null)
{
    <h4>Edit: @editingBook.Name</h4>
    <EditForm Model="editBook" OnValidSubmit="HandleEditBook">
        <DataAnnotationsValidator />
        <div><label>Title</label><InputText @bind-Value="editBook.Name" /></div>
        <div>
            <label>Author</label>
            <InputSelect @bind-Value="editBook.AuthorId" class="form-control" style="width: 230px">
                <option value="0">-- Select Author --</option>
                @foreach (var author in authors ?? [])
                {
                    <option value="@author.Id">@author.Name</option>
                }
            </InputSelect>
        </div>
        <div><label>Price</label><InputNumber @bind-Value="editBook.Price" /></div>
        <div><label>Release Date</label><InputDate @bind-Value="editBook.ReleaseDate" /></div>
        <button type="submit" class="btn btn-warning">Save</button>
        <button type="button" @onclick="() => editingBook = null">Cancel</button>
    </EditForm>
}

@if (books is null){
    <p><em>Loading your books....</em></p>
}
else if (books.Length == 0){
    <p>No books found. Go add some!</p>
}
else{
    <table class="table table-striped table-bordered mt-4">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Author</th>
                <th>Price</th>
                <th>Release Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in books)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Name</td>
                    <td>@book.Author</td>
                    <td>$@book.Price</td>
                    <td>@book.ReleaseDate.ToString("MMMM dd, yyyy")</td>
                    <td>
                        <button @onclick="() => HandleDeleteBook(book.Id)">Delete</button>
                        <button @onclick="() => StartEdit(book)">Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code{
    private AuthorDto []? authors;
    private BookSummaryDto[]? books;
    private CreateBookDto newBook = new(){ReleaseDate = new DateOnly(2000, 1, 1)};
    private BookSummaryDto? editingBook;
    private UpdateBookDto editBook = new();
    private void StartEdit(BookSummaryDto book){
        editingBook = book;
        editBook = new UpdateBookDto{
            Name = book.Name,
            AuthorId = authors?.FirstOrDefault(a => a.Name == book.Author)?.Id ?? 0,
            Price = book.Price
        };
    }
    private string? errMessage;

    protected override async Task OnInitializedAsync(){
        books = await Clients.GetBooksAsync();
        authors = await AuthorClients.GetAuthorsAsync();
    }

    private async Task HandleAddBook()
    {
        errMessage =  await Clients.AddBookAsync(newBook);
        if (errMessage is null){
            books = await Clients.GetBooksAsync();
            newBook = new(){ReleaseDate = new DateOnly(2000, 01, 01)};
            @* newBook = new(); *@
        }
    }

    private async Task HandleDeleteBook(int id){
        await Clients.DeleteBookAsync(id);
        books = await Clients.GetBooksAsync();
    }
    private async Task HandleEditBook(){
        errMessage = await Clients.UpdateBookAsync(editingBook!.Id, editBook);
        if (errMessage is null){
            books = await Clients.GetBooksAsync();
            editingBook = null;
        }
    }
}
